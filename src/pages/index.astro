---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Mundo from '../components/sections/Mundo.astro';
import Baralla from '../components/sections/Baralla.astro';
import Produtos from '../components/sections/Produtos.astro';
import Novas from '../components/sections/Novas.astro';
import { catalogo } from '../lib/jsonld';
import Newsletter from '../components/sections/Newsletter.astro';

const datos = catalogo('gl', Astro.site ?? new URL(Astro.url.origin));
---

<Layout jsonld={datos}>
  <Hero />
  <Mundo />
  <Baralla />
  <Produtos />
  <Novas />
  <Newsletter />
</Layout>
