---
import { produtos } from '../../data/produtos';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { ENVIO_GRATIS_DESDE, ENVIO_TARIFA, ZONA_DISPONIBLE } from '../../data/envio';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const catalogo = produtos.map((p) => ({
  id: p.id,
  nome: p.nome[lang],
  prezo: p.prezo,
  max: p.max ?? 99,
  imaxe: typeof p.imaxe === 'string' ? p.imaxe : null,
  insignia: p.insignia?.[lang] ?? null,
}));

const textos = {
  inc: t('cart.inc'),
  dec: t('cart.dec'),
  remove: t('cart.remove'),
  added: t('cart.added'),
  max: t('cart.max'),
  unavailable: t('cart.unavailable'),
  error: t('cart.error'),
  free: t('cart.free'),
  hint: t('cart.hint'),
  zoneUnavailable: t('cart.zone.unavailable'),
};

const envio = { gratisDesde: ENVIO_GRATIS_DESDE, tarifa: ENVIO_TARIFA, zona: ZONA_DISPONIBLE };
---

<dialog class="carro" id="carro" aria-labelledby="carro-titulo">
  <div class="carro__panel">
    <header class="carro__cabeceira">
      <h2 id="carro-titulo">{t('cart.title')}</h2>
      <button class="carro__pechar" type="button" data-pechar aria-label={t('cart.close')}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </header>

    <p class="carro__baleiro" data-baleiro>{t('cart.empty')}</p>
    <ul class="carro__lista" data-lista hidden></ul>

    <footer class="carro__pe" data-pe hidden>
      <fieldset class="carro__zona">
        <legend>{t('cart.zone')}</legend>
        <label><input type="radio" name="zona" value={ZONA_DISPONIBLE} checked /> {t('cart.zone.pen')}</label>
        <label><input type="radio" name="zona" value="outra" /> {t('cart.zone.other')}</label>
      </fieldset>
      <p class="carro__fila"><span>{t('cart.subtotal')}</span><span data-subtotal></span></p>
      <p class="carro__fila"><span>{t('cart.shipping')}</span><span data-envio></span></p>
      <p class="carro__pista" data-pista hidden></p>
      <p class="carro__subtotal"><span>{t('cart.total')}</span><strong data-total></strong></p>
      <p class="carro__nota">{t('cart.vatNote')}</p>
      <p class="carro__aviso" role="status" data-aviso hidden></p>
      <button class="btn btn--comprar carro__pagar" type="button" data-pagar>{t('cart.checkout')}</button>
      <button class="carro__seguir" type="button" data-pechar>{t('cart.continue')}</button>
    </footer>
  </div>
  <p class="carro__anuncio" role="status" aria-live="polite" data-anuncio></p>
</dialog>

<script type="application/json" id="carro-catalogo" set:html={JSON.stringify(catalogo)} />
<script type="application/json" id="carro-textos" set:html={JSON.stringify(textos)} />
<script type="application/json" id="carro-envio" set:html={JSON.stringify(envio)} />

<style is:global>
  .carro {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--texto);
  }
  .carro::backdrop { background: rgb(0 0 0 / 0.62); }
  .carro__panel {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    display: flex;
    flex-direction: column;
    width: min(26rem, 100%);
    background: var(--tinta);
    border-inline-start: 1px solid var(--ouro-vello);
    box-shadow: -16px 0 48px rgb(0 0 0 / 0.5);
  }
  @media (prefers-reduced-motion: no-preference) {
    .carro[open] .carro__panel { animation: carro-entra 0.32s var(--ease); }
    .carro[open]::backdrop { animation: carro-vela 0.32s var(--ease); }
  }
  @keyframes carro-entra { from { transform: translateX(100%); } }
  @keyframes carro-vela { from { opacity: 0; } }

  .carro__cabeceira {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5, 1.25rem) var(--space-6);
    border-bottom: 1px solid var(--borde);
  }
  .carro__cabeceira h2 { font-size: var(--text-lg); text-transform: uppercase; letter-spacing: 0.06em; }
  .carro__pechar, .linea__quitar {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--texto-2);
    background: none;
    border: 1px solid var(--borde);
    border-radius: 50%;
    cursor: pointer;
  }
  .carro__pechar:hover, .linea__quitar:hover { color: var(--ouro-claro); border-color: var(--ouro-vello); }
  .carro button:focus-visible { outline: 2px solid var(--ouro-claro); outline-offset: 2px; }

  .carro__baleiro { padding: var(--space-8) var(--space-6); color: var(--texto-2); }
  .carro__lista {
    flex: 1;
    margin: 0;
    padding: 0 var(--space-6);
    overflow-y: auto;
    list-style: none;
  }
  .carro__lista[hidden], .carro__pe[hidden], .carro__aviso[hidden] { display: none; }

  .linea {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--borde);
  }
  .linea__imx {
    display: grid;
    place-items: center;
    width: 4rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radio);
    background: var(--granito-escuro);
    border: 1px solid var(--ouro-vello);
    font-family: var(--fonte-display);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ouro-claro);
    text-align: center;
  }
  .linea__imx img { width: 100%; height: 100%; object-fit: cover; }
  .linea__nome { font-size: var(--text-sm); line-height: 1.25; }
  .linea__un { margin-top: 0.15rem; font-size: var(--text-xs); color: var(--texto-2); }
  .linea__qty { display: inline-flex; align-items: center; gap: var(--space-2); grid-column: 2; }
  .linea__qty button {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--ouro-claro);
    background: var(--tinta-suave);
    border: 1px solid var(--ouro-vello);
    border-radius: 50%;
    cursor: pointer;
    line-height: 1;
  }
  .linea__qty button:hover { color: var(--pergamino-alto); }
  .linea__qty output { min-width: 1.5rem; text-align: center; font-variant-numeric: tabular-nums; }
  .linea__total { grid-column: 3; justify-self: end; font-family: var(--fonte-display); color: var(--ouro-claro); }
  .linea__quitar { grid-column: 3; grid-row: 1; width: 1.75rem; height: 1.75rem; justify-self: end; }

  .carro__pe { display: grid; gap: var(--space-3); padding: var(--space-6); border-top: 1px solid var(--ouro-vello); }
  .carro__subtotal { display: flex; justify-content: space-between; align-items: baseline; margin: 0; }
  .carro__subtotal strong { font-family: var(--fonte-display); font-size: var(--text-xl); color: var(--ouro-claro); }
  .carro__zona { margin: 0; padding: 0; border: 0; display: grid; gap: var(--space-2); }
  .carro__zona legend { padding: 0; margin-bottom: var(--space-2); font-size: var(--text-xs); letter-spacing: 0.16em; text-transform: uppercase; color: var(--texto-2); }
  .carro__zona label { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); cursor: pointer; }
  .carro__zona input { accent-color: var(--ouro-claro); }
  .carro__fila { display: flex; justify-content: space-between; margin: 0; font-size: var(--text-sm); color: var(--texto-2); }
  .carro__pista { margin: 0; font-size: var(--text-xs); color: var(--ouro-claro); }
  .carro__pista[hidden] { display: none; }
  .carro__nota { margin: 0; font-size: var(--text-xs); color: var(--texto-2); }
  .carro__aviso { margin: 0; font-size: var(--text-sm); color: var(--pergamino-alto); }
  .carro__pagar { width: 100%; justify-content: center; }
  .carro__seguir {
    padding: var(--space-2);
    color: var(--texto-2);
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    font: inherit;
    font-size: var(--text-sm);
  }
  .carro__seguir:hover { color: var(--ouro-claro); }
  .carro__anuncio { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>

<script>
  import { obterLineas, engadir, quitar, fixarCantidade, subscribirse } from '../../lib/cart';

  interface Item { id: string; nome: string; prezo: number; max: number; imaxe: string | null; insignia: string | null }
  const ler = <T,>(id: string): T => JSON.parse(document.getElementById(id)?.textContent ?? 'null');
  const catalogo = new Map(ler<Item[]>('carro-catalogo').map((p) => [p.id, p]));
  const txt = ler<Record<string, string>>('carro-textos');
  const env = ler<{ gratisDesde: number; tarifa: number; zona: string }>('carro-envio');

  const dlg = document.getElementById('carro') as HTMLDialogElement;
  const lista = dlg.querySelector<HTMLElement>('[data-lista]')!;
  const baleiro = dlg.querySelector<HTMLElement>('[data-baleiro]')!;
  const pe = dlg.querySelector<HTMLElement>('[data-pe]')!;
  const total = dlg.querySelector<HTMLElement>('[data-total]')!;
  const aviso = dlg.querySelector<HTMLElement>('[data-aviso]')!;
  const pagar = dlg.querySelector<HTMLButtonElement>('[data-pagar]')!;
  const anuncio = dlg.querySelector<HTMLElement>('[data-anuncio]')!;
  const subtotalEl = dlg.querySelector<HTMLElement>('[data-subtotal]')!;
  const envioEl = dlg.querySelector<HTMLElement>('[data-envio]')!;
  const pistaEl = dlg.querySelector<HTMLElement>('[data-pista]')!;

  const zona = () => dlg.querySelector<HTMLInputElement>('input[name="zona"]:checked')?.value ?? env.zona;
  const zonaOk = () => zona() === env.zona;
  function actualizarPago() {
    pagar.disabled = !zonaOk();
    if (!zonaOk()) {
      aviso.textContent = txt.zoneUnavailable;
      aviso.hidden = false;
    } else if (aviso.textContent === txt.zoneUnavailable) {
      aviso.hidden = true;
    }
  }
  dlg.querySelectorAll('input[name="zona"]').forEach((r) => r.addEventListener('change', pintar));

  const locale = document.documentElement.lang === 'es' ? 'es-ES' : 'gl-ES';
  const eur = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', minimumFractionDigits: 2 });
  const prezo = (cents: number) => eur.format(cents / 100);

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  };
  const boton = (cls: string, label: string, text: string, foco: string, accion: () => void) => {
    const b = el('button', cls, text);
    b.type = 'button';
    b.setAttribute('aria-label', label);
    b.dataset.foco = foco;
    b.addEventListener('click', accion);
    return b;
  };

  function fila(id: string, qty: number, p: Item) {
    const li = el('li', 'linea');
    const imx = el('div', 'linea__imx');
    if (p.imaxe) {
      const img = el('img');
      img.src = p.imaxe;
      img.alt = '';
      img.loading = 'lazy';
      imx.append(img);
    } else if (p.insignia) {
      imx.textContent = p.insignia;
    }
    const info = el('div');
    info.append(el('p', 'linea__nome', p.nome), el('p', 'linea__un', prezo(p.prezo)));

    const cant = el('div', 'linea__qty');
    const out = el('output', undefined, String(qty));
    cant.append(
      boton('', `${txt.dec}: ${p.nome}`, '−', `${id}:dec`, () => fixarCantidade(id, qty - 1)),
      out,
      boton('', `${txt.inc}: ${p.nome}`, '+', `${id}:inc`, () => fixarCantidade(id, qty + 1))
    );

    const inc = cant.querySelector<HTMLButtonElement>('[data-foco$=":inc"]');
    if (inc && qty >= p.max) inc.disabled = true;

    const quitarBtn = boton('linea__quitar', `${txt.remove}: ${p.nome}`, '×', `${id}:del`, () => quitar(id));
    li.append(imx, info, quitarBtn, cant, el('p', 'linea__total', prezo(p.prezo * qty)));
    return li;
  }

  function pintar() {
    const activo = (document.activeElement as HTMLElement | null)?.dataset?.foco;
    const lineas = obterLineas().filter((l) => catalogo.has(l.id));
    lista.replaceChildren(...lineas.map((l) => fila(l.id, l.qty, catalogo.get(l.id)!)));
    lista.hidden = pe.hidden = lineas.length === 0;
    baleiro.hidden = lineas.length > 0;
    const sub = lineas.reduce((s, l) => s + l.qty * catalogo.get(l.id)!.prezo, 0);
    const envio = sub >= env.gratisDesde ? 0 : env.tarifa;
    subtotalEl.textContent = prezo(sub);
    envioEl.textContent = !zonaOk() ? '—' : envio === 0 ? txt.free : prezo(envio);
    total.textContent = prezo(sub + (zonaOk() ? envio : 0));
    pistaEl.hidden = !(zonaOk() && envio > 0 && sub > 0);
    pistaEl.textContent = pistaEl.hidden ? '' : txt.hint.replace('{x}', prezo(env.gratisDesde - sub));
    aviso.hidden = true;
    actualizarPago();

    if (activo && dlg.open) {
      const volver = dlg.querySelector<HTMLElement>(`[data-foco="${activo}"]`) ?? dlg.querySelector<HTMLElement>('[data-pechar]');
      (volver instanceof HTMLButtonElement && volver.disabled
        ? dlg.querySelector<HTMLElement>(`[data-foco="${activo.replace(':inc', ':dec')}"]`)
        : volver
      )?.focus();
    }

    const n = lineas.reduce((s, l) => s + l.qty, 0);
    document.querySelectorAll<HTMLElement>('[data-carro-abrir]').forEach((b) => {
      b.setAttribute('aria-label', `${b.dataset.label ?? ''} (${n})`);
      const num = b.querySelector<HTMLElement>('[data-carro-num]');
      if (num) {
        num.textContent = n > 99 ? '99+' : String(n);
        num.hidden = n === 0;
      }
    });
  }

  const abrir = () => {
    if (!dlg.open) dlg.showModal();
    document.documentElement.style.overflow = 'hidden';
  };
  dlg.addEventListener('close', () => (document.documentElement.style.overflow = ''));
  dlg.addEventListener('click', (e) => e.target === dlg && dlg.close());
  dlg.querySelectorAll('[data-pechar]').forEach((b) => b.addEventListener('click', () => dlg.close()));

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const add = t.closest<HTMLElement>('[data-add]');
    if (add) {
      const id = add.dataset.add!;
      if (!catalogo.has(id)) return;
      const actual = obterLineas().find((l) => l.id === id)?.qty ?? 0;
      if (actual >= catalogo.get(id)!.max) {
        anuncio.textContent = txt.max;
        abrir();
        return;
      }
      engadir(id);
      anuncio.textContent = `${catalogo.get(id)!.nome} ${txt.added}`;
      document.querySelectorAll('[data-carro-abrir]').forEach((b) => {
        b.classList.remove('carro-btn--salto');
        void (b as HTMLElement).offsetWidth;
        b.classList.add('carro-btn--salto');
      });
      abrir();
      return;
    }
    if (t.closest('[data-carro-abrir]')) abrir();
  });

  // Pago: POST {items, lang} a /api/checkout; el servidor recalcula precios por id y devuelve la URL de Stripe.
  const ENDPOINT = (import.meta.env.PUBLIC_CHECKOUT_ENDPOINT as string | undefined) ?? '/api/checkout';
  pagar.addEventListener('click', async () => {
    const mostrar = (m: string) => {
      aviso.textContent = m;
      aviso.hidden = false;
    };
    pagar.disabled = true;
    try {
      const r = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lang: document.documentElement.lang, zona: zona(), items: obterLineas() }),
      });
      if (r.status === 503) {
        mostrar(txt.unavailable);
        actualizarPago();
        return;
      }
      const { url } = await r.json();
      if (!r.ok || typeof url !== 'string') throw new Error('checkout');
      location.assign(url);
    } catch {
      mostrar(txt.error);
      actualizarPago();
    }
  });

  // Al volver con el botón Atrás desde Stripe la página puede restaurarse con el botón bloqueado
  window.addEventListener('pageshow', (e) => e.persisted && actualizarPago());

  subscribirse(pintar);
</script>
