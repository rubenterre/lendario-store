---
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const ano = new Date().getFullYear();
---

<footer class="pe">
  <div class="container pe__interior">
    <p class="pe__marca">Lendario</p>
    <p class="pe__texto">{t('footer.tagline')}</p>
    <nav class="pe__nav" aria-label={t('footer.legal')}>
      <a href={localizedPath(lang, '/politicas')}>{t('footer.policies')}</a>
      <a href={localizedPath(lang, '/privacidade')}>{t('footer.privacy')}</a>
    </nav>
    <p class="pe__legal">© {ano} Lendario. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .pe {
    border-top: 1px solid var(--borde);
    padding-block: var(--space-12);
    margin-top: var(--space-16);
  }
  .pe__interior {
    display: grid;
    gap: var(--space-3);
    text-align: center;
  }
  .pe__marca {
    font-family: var(--fonte-display);
    font-size: var(--text-lg);
    letter-spacing: 0.04em;
  }
  .pe__texto { color: var(--texto-2); }
  .pe__nav { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2) var(--space-6); }
  .pe__nav a { color: var(--texto-2); text-decoration: underline; text-underline-offset: 3px; }
  .pe__nav a:hover, .pe__nav a:focus-visible { color: var(--ouro-claro); }
  .pe__legal { color: var(--texto-2); font-size: var(--text-xs); }
</style>
