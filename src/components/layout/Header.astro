---
import { Image } from 'astro:assets';
import logo from '../../assets/logo-lendario.webp';
import { getLangFromUrl, useTranslations, langs, languages, localizedPath, stripLang } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = stripLang(Astro.url.pathname);
const home = localizedPath(lang, '/');

const enlaces = [
  { href: `${home}#mundo`, label: t('nav.world') },
  { href: `${home}#baralla`, label: t('nav.deck') },
  { href: `${home}#edicions`, label: t('nav.editions') },
  { href: `${home}#novas`, label: t('nav.news') },
];
---

<header class="cabeceira" data-cabeceira>
  <div class="cabeceira__interior">
    <a class="cabeceira__logo" href={home} aria-label={t('a11y.home')}>
      <Image src={logo} alt="" height={80} widths={[160, 240]} sizes="120px" loading="eager" />
    </a>

    <nav class="cabeceira__nav" id="nav-principal" aria-label="Principal">
      {enlaces.map((e) => <a href={e.href}>{e.label}</a>)}
    </nav>

    <div class="cabeceira__accions">
      <a class="btn btn--comprar cabeceira__comprar" href={`${home}#edicions`}>{t('header.buy')}</a>

      <button class="carro-btn" type="button" data-carro-abrir data-label={t('cart.open')} aria-label={t('cart.open')} aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 8h14l-1.200 11H6.200L5 8Z" /><path d="M9 8V6.500a3 3 0 0 1 6 0V8" />
        </svg>
        <span class="carro-btn__num" data-carro-num hidden>0</span>
      </button>

      <details class="idiomas">
        <summary aria-label={t('a11y.langSwitch')}>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.6 2.7 3.9 5.7 3.9 9S14.600 18.300 12 21c-2.600-2.700-3.900-5.700-3.900-9S9.400 5.700 12 3Z" />
          </svg>
        </summary>
        <ul>
          {langs.map((l) => (
            <li>
              <a href={localizedPath(l, base)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
                {languages[l]}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <button class="cabeceira__burger" type="button" aria-expanded="false" aria-controls="nav-principal" aria-label={t('a11y.menu')}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .cabeceira {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--tinta) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 2px solid ;
    border-image: linear-gradient(135deg,#5d442300, var(--ouro-claro), #5d442300) 1;
  }
  .cabeceira__interior {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-6);
    width: min(100% - 2rem, 90rem);
    margin-inline: auto;
    min-height: 4rem;
  }
  .cabeceira__logo { display: inline-flex; justify-self: start; cursor: pointer;}
  .cabeceira__logo :global(img) { height: 2.5rem; width: auto; }

  .cabeceira__nav { display: flex; gap: var(--space-8); }
  .cabeceira__nav a {
    text-decoration: none;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--texto);
    padding-block: var(--space-2);
    border-bottom: 1px solid transparent;
  }
  .cabeceira__nav a:hover { color: var(--ouro-claro); border-color: var(--ouro-vello); }

  .cabeceira__accions { display: flex; align-items: center; gap: var(--space-4); justify-self: end; }
  .cabeceira__comprar { padding: 0.55em 1.4em; font-size: var(--text-xs); }

  .carro-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ouro-claro);
    background: var(--tinta-suave);
    border: 1px solid var(--ouro-vello);
    border-radius: 50%;
    cursor: pointer;
  }
  .carro-btn:hover { color: var(--pergamino-alto); }
  .carro-btn:focus-visible { outline: 2px solid var(--ouro-claro); outline-offset: 3px; }
  .carro-btn__num {
    position: absolute;
    top: -0.35rem;
    inset-inline-end: -0.35rem;
    display: grid;
    place-items: center;
    min-width: 1.15rem;
    height: 1.15rem;
    padding-inline: 0.25rem;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    color: var(--tinta);
    background: var(--ouro-claro);
    border-radius: 999px;
  }
  .carro-btn__num[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .carro-btn--salto { animation: carro-salto 0.45s var(--ease); }
  }
  @keyframes carro-salto { 40% { transform: scale(1.2); } }

  .idiomas { position: relative; }
  .idiomas summary {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    list-style: none;
    cursor: pointer;
    color: var(--ouro-claro);
    border: 1px solid var(--ouro-vello);
    border-radius: 50%;
    background: var(--tinta-suave);
  }
  .idiomas summary::-webkit-details-marker { display: none; }
  .idiomas summary:hover { color: var(--pergamino-alto); }
  .idiomas summary:focus-visible { outline: 2px solid var(--ouro-claro); outline-offset: 3px; }
  .idiomas ul {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + var(--space-2));
    min-width: 9rem;
    margin: 0;
    padding: var(--space-2);
    list-style: none;
    background: var(--tinta-suave);
    border: 1px solid var(--ouro-vello);
    border-radius: var(--radio);
  }
  .idiomas ul a {
    display: block;
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    font-size: var(--text-sm);
    color: var(--texto-2);
  }
  .idiomas ul a:hover { color: var(--ouro-claro); }
  .idiomas ul a[aria-current='true'] { color: var(--ouro-claro); }

  .cabeceira__burger { display: none; }

  @media (max-width: 860px) {
    .cabeceira__interior { grid-template-columns: auto 1fr; }
    .cabeceira__burger {
      display: grid;
      gap: 5px;
      place-content: center;
      width: 2.5rem;
      height: 2.5rem;
      background: none;
      border: 1px solid var(--borde);
      border-radius: var(--radio);
      cursor: pointer;
    }
    .cabeceira__burger span { display: block; width: 1.2rem; height: 1px; background: var(--texto); }
    .cabeceira__nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      gap: 0;
      padding: var(--space-4) 1rem;
      background: var(--tinta);
      border-bottom: 1px solid var(--ouro-vello);
    }
    .cabeceira__nav a { padding-block: var(--space-3); font-size: var(--text-sm); }
    .cabeceira[data-abierto] .cabeceira__nav { display: flex; }
  }
  @media (max-width: 420px) { .cabeceira__comprar { display: none; } }
</style>

<script>
  const cab = document.querySelector<HTMLElement>('[data-cabeceira]');
  const btn = cab?.querySelector<HTMLButtonElement>('.cabeceira__burger');
  const cerrar = () => {
    cab?.removeAttribute('data-abierto');
    btn?.setAttribute('aria-expanded', 'false');
  };
  btn?.addEventListener('click', () => {
    const abierto = cab?.toggleAttribute('data-abierto');
    btn.setAttribute('aria-expanded', String(!!abierto));
  });
  cab?.querySelectorAll('.cabeceira__nav a').forEach((a) => a.addEventListener('click', cerrar));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && cerrar());
</script>
