---
import { Image } from 'astro:assets';
import fondo from '../../assets/ui/fondo_baralla.webp';
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="section confirmado" aria-labelledby="confirmado-titulo">
  <Image class="confirmado__fondo" src={fondo} alt="" widths={[1100, 1650, 2200]} sizes="100vw" loading="eager" aria-hidden="true" />
  <div class="confirmado__caixa">
    <p class="eyebrow">{t('newsletter.confirmedEyebrow')}</p>
    <h1 id="confirmado-titulo">{t('newsletter.confirmedTitle')}</h1>
    <p class="lead">{t('newsletter.confirmedText')}</p>
    <a class="btn btn--fantasma" href={localizedPath(lang, '/')}>{t('thanks.back')}</a>
  </div>
</section>

<style>
  .confirmado { display: grid; place-items: center; min-height: 70vh; text-align: center; isolation: isolate; overflow: hidden; }
  .confirmado :global(.confirmado__fondo) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  /* Velo oscuro para que el texto se lea bien sobre la imagen */
  .confirmado::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(23 21 15 / 0.65);
    pointer-events: none;
  }
  .confirmado__caixa { display: grid; justify-items: center; gap: var(--space-6); width: min(100% - 2rem, 40rem); }
  .confirmado h1 { font-size: var(--text-2xl); text-transform: uppercase; letter-spacing: 0.04em; line-height: 1.05; }
</style>
