---
import { Image } from 'astro:assets';
import insignia from '../../assets/ui/lendario_badge_big.svg';
import respaldo from '../../assets/images/Hero-breogan-heroe.webp';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section class="hero" aria-labelledby="hero-titulo" data-hero>
  <!-- Imagen de respaldo: móvil, sin JavaScript, movimiento reducido o vídeo no compatible -->
  <Image
    class="hero__respaldo"
    src={respaldo}
    alt=""
    widths={[640, 960, 1376]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Sin <source>: el script lo añade solo en pantallas anchas -->
  <video
    class="hero__video"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    data-src="/videos/hero_animacion_breogan.mp4"
  >
  </video>
  <div class="hero__velo" aria-hidden="true"></div>

  <div class="hero__contido">
    <h1 id="hero-titulo" class="sr-only">{t('hero.title')}</h1>
    <Image class="hero__insignia" src={insignia} alt="" width={417} height={375} loading="eager" />
    <a class="btn btn--comprar" href="#edicions">{t('hero.cta')}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    justify-items: center;
    height: clamp(30rem, 36vw, 48rem);
    overflow: hidden;
    background: var(--tinta);
  }
  .hero :global(.hero__respaldo),
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .hero :global(.hero__respaldo) { z-index: -3; }
  .hero__video {
    z-index: -2;
    opacity: 0;
    transition: opacity 0.8s var(--ease);
  }
  .hero[data-video-listo] .hero__video { opacity: 1; }

  /* Fundido inferior hacia el fondo de la página */
  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, transparent 55%, var(--bg) 100%);
  }
  .hero__contido {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding-block-end: var(--space-8);
  }
  .hero__contido :global(.hero__insignia) {
    width: clamp(9rem, 13vw, 15rem);
    height: auto;
    filter: drop-shadow(0 6px 18px rgb(0 0 0 / 0.55));
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  // El vídeo solo se carga en pantallas anchas, sin movimiento reducido ni ahorro de datos
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const video = hero?.querySelector<HTMLVideoElement>('.hero__video');
  const conexion = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;

  const puedeReproducir =
    matchMedia('(min-width: 768px)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches &&
    !conexion?.saveData;

  if (hero && video?.dataset.src && puedeReproducir) {
    video.addEventListener('playing', () => hero.setAttribute('data-video-listo', ''), { once: true });
    video.src = video.dataset.src;
    video.play().catch(() => {
      /* Si el navegador bloquea la reproducción, se queda la imagen */
    });
  }
</script>
