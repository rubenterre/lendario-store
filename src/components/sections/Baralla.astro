---
import { Image } from 'astro:assets';
import fondo from '../../assets/ui/fondo_baralla.webp';
import c14 from '../../assets/images/baralla/14_oros_alpha.webp';
import c15 from '../../assets/images/baralla/15_oros_alpha.webp';
import c24 from '../../assets/images/baralla/24_espadas_alpha.webp';
import c2 from '../../assets/images/baralla/02_comodin_alpha.webp';
import c29 from '../../assets/images/baralla/29_copas_alpha.webp';
import c50 from '../../assets/images/baralla/50_bastos_alpha.webp';
import c52 from '../../assets/images/baralla/52_bastos_alpha.webp';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));

const cartas = [
  { img: c14, palo: 'ouros' },
  { img: c15, palo: 'ouros' },
  { img: c24, palo: 'espadas' },
  { img: c2, palo: 'comodin', inicial: true },
  { img: c29, palo: 'copas' },
  { img: c50, palo: 'bastos' },
  { img: c52, palo: 'bastos' },
] as const;
---

<section class="section baralla" id="baralla" aria-labelledby="baralla-titulo" data-baralla>
  <Image
    class="baralla__fondo"
    src={fondo}
    alt="Fondo de paisaxe lendario e treboada ao lonxe"
    widths={[960, 1440, 1920]}
    sizes="100vw"
    quality={70}
    loading="lazy"
    aria-hidden="true"
  />

  <header class="baralla__cabeceira reveal">
    <p class="eyebrow">{t('deck.eyebrow')}</p>
    <h2 id="baralla-titulo">{t('deck.title')}</h2>
  </header>

  <div class="carrusel reveal" role="region" aria-roledescription="carrusel" aria-label={t('deck.region')}>
    <ul class="carrusel__pista" tabindex="0">
      {
        cartas.map((c, i) => (
          <li class="carta" aria-label={`${i + 1} / ${cartas.length}`} data-inicial={"inicial" in c ? "" : undefined}>
            <Image
              src={c.img}
              alt={c.palo === 'comodin' ? t('deck.joker') : `${t('deck.card')} ${t(`suits.${c.palo}.name` as const)}`}
              width={407}
              height={607}
              sizes="(min-width: 900px) 25rem, 70vw"
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>

    <div class="carrusel__controis">
      <button class="seta" type="button" data-dir="-1" aria-label={t('deck.prev')}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <p class="carrusel__pista-texto">{t('deck.hint')}</p>
      <button class="seta" type="button" data-dir="1" aria-label={t('deck.next')}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .baralla {
    --carta-ancho: clamp(14rem, 26vw, 25.4rem);
    isolation: isolate;
    overflow: hidden;
  }
  .baralla :global(.baralla__fondo) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  /* Fundido superior e inferior hacia el color de la página */
  .baralla::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, var(--bg) 0%, transparent 22%, transparent 78%, var(--bg) 100%);
    pointer-events: none;
  }

  .baralla__cabeceira { text-align: center;padding: 0px 10px; }
  .baralla__cabeceira h2 {
    margin-top: var(--space-2);
    font-size: var(--text-2xl);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.05;
  }

  .carrusel { margin-top: var(--space-12); }
  .carrusel__pista {
    display: flex;
    align-items: center;
    gap: 0;
    margin: 0;
    padding: var(--space-8) calc(50% - var(--carta-ancho) / 2);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .carrusel__pista::-webkit-scrollbar { display: none; }
  .carrusel__pista:focus-visible { outline: 2px solid var(--ouro-claro); outline-offset: -2px; }

  /* --d: distancia con signo al centro; --a: distancia absoluta (las calcula el script) */
  .carta {
    --d: 0;
    --a: 0;
    flex: none;
    width: var(--carta-ancho);
    margin-inline: calc(var(--carta-ancho) * -0.12);
    scroll-snap-align: center;
    cursor: pointer;
    transform: translateX(calc(var(--d) * -6%)) scale(calc(1 - var(--a) * 0.1));
    opacity: calc(1 - var(--a) * 0.32);
    filter: drop-shadow(0 14px 28px rgb(0 0 0 / 0.55));
    transition: opacity 0.3s var(--ease);
  }
  .carta :global(img) { display: block; width: 100%; height: auto; }

  .carrusel__controis {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .carrusel__pista-texto {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    color: var(--texto-2);
  }
  .seta {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--ouro-claro);
    background: var(--tinta-suave);
    border: 1px solid var(--ouro-vello);
    border-radius: 50%;
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .seta:hover:not(:disabled) { color: var(--pergamino-alto); border-color: var(--ouro-claro); }
  .seta:focus-visible { outline: 2px solid var(--ouro-claro); outline-offset: 3px; }
  .seta:disabled { opacity: 0.35; cursor: default; }
</style>


<script>
  const raiz = document.querySelector<HTMLElement>('[data-baralla]');
  const pista = raiz?.querySelector<HTMLElement>('.carrusel__pista');
  const cartas = pista ? Array.from(pista.querySelectorAll<HTMLElement>('.carta')) : [];
  const botones = raiz ? Array.from(raiz.querySelectorAll<HTMLButtonElement>('.seta')) : [];
  const reducido = matchMedia('(prefers-reduced-motion: reduce)');

  if (pista && cartas.length) {
    let tick = false;

    const actualizar = () => {
      tick = false;
      const centro = pista.scrollLeft + pista.clientWidth / 2;
      let activa = 0;
      let mejor = Infinity;
      cartas.forEach((c, i) => {
        const d = (c.offsetLeft + c.offsetWidth / 2 - centro) / c.offsetWidth;
        const a = Math.min(Math.abs(d), 2.5);
        c.style.setProperty('--d', d.toFixed(3));
        c.style.setProperty('--a', a.toFixed(3));
        c.style.zIndex = String(10 - Math.round(a * 2));
        if (a < mejor) { mejor = a; activa = i; }
      });
      botones[0] && (botones[0].disabled = activa === 0);
      botones[1] && (botones[1].disabled = activa === cartas.length - 1);
      pista.dataset.activa = String(activa);
    };

    const irA = (i: number) => {
      const c = cartas[Math.max(0, Math.min(cartas.length - 1, i))];
      const destino = c.offsetLeft + c.offsetWidth / 2 - pista.clientWidth / 2;
      pista.scrollTo({ left: destino, behavior: reducido.matches ? 'auto' : 'smooth' });
    };

    const inicializarBaraja = () => {
      const c0 = cartas.find((c) => c.hasAttribute('data-inicial')) ?? cartas[0];
      const destino = c0.offsetLeft + c0.offsetWidth / 2 - pista.clientWidth / 2;
      pista.scrollTo({ left: destino, behavior: 'instant' });
      actualizar();
    };

    pista.addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(actualizar); } }, { passive: true });
    window.addEventListener('resize', actualizar);
    botones.forEach((b) =>
      b.addEventListener('click', () => irA(Number(pista.dataset.activa ?? 0) + Number(b.dataset.dir)))
    );
    cartas.forEach((c, i) => c.addEventListener('click', () => irA(i)));
    pista.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); irA(Number(pista.dataset.activa ?? 0) + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); irA(Number(pista.dataset.activa ?? 0) - 1); }
    });

    // Esperar a que la página y recursos carguen por completo para calcular los offsets reales
    if (document.readyState === 'complete') {
      inicializarBaraja();
    } else {
      window.addEventListener('load', inicializarBaraja, { once: true });
    }
  }
</script>
