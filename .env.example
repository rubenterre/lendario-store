# Copia este archivo a .env (está en .gitignore) y rellena los valores. En producción van en Netlify > Environment variables.
STRIPE_SECRET_KEY=
SITE_URL=
STRIPE_SHIPPING_COUNTRIES=ES

# Brevo (boletín). Clave de API: Brevo > SMTP y API > Claves de API. NUNCA con prefijo PUBLIC_.
BREVO_API_KEY=
# ID de la lista (número) y de la plantilla de doble confirmación (número).
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
# Opcional: nombre del atributo de texto en Brevo para guardar el idioma (p. ej. IDIOMA). Vacío = no se guarda.
BREVO_LANG_ATTRIBUTE=
